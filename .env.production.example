# Production values. Copy to .env.production.local (gitignored) for the prod:* commands, and enter
# the same values in your host's environment settings. A separate worker box gets the same file as
# .env.worker with the *direct* database URL. Everything about the user is entered in the app.

# --- Database (e.g. Neon) ---
# App: the POOLED connection string (host contains "-pooler").
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require
# Migrations, pg-boss and the worker: the DIRECT connection string (no "-pooler").
DIRECT_DATABASE_URL=postgresql://USER:PASSWORD@ep-xxx.eu-central-1.aws.neon.tech/neondb?sslmode=require

# --- App (HTTPS URL of the app or your custom domain) ---
APP_URL=https://jobs.example.com
AUTH_URL=https://jobs.example.com
AUTH_TRUST_HOST=true
# Same values as local if you restore your local database (stored keys are encrypted with it).
AUTH_SECRET=
APP_ENCRYPTION_KEY=
TZ=UTC

# --- Optional: Google OAuth (Connect Gmail + "Continue with Google"). Redirect URIs to register:
#   ${APP_URL}/api/gmail/callback   and   ${APP_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Worker only (docker-compose.worker.yml / .env.worker) ---
# Keep a serverless database inside its free compute budget: the worker disconnects outside these hours (in TZ).
WORKER_ACTIVE_HOURS=08:00-23:00
WORKER_ACTIVE_DAYS=1-5

# --- Web only ---
# Serverless hosts cannot reach port 25; leave unset so mailbox verification is done by the worker.
CONTACT_VERIFY_IN_WEB=

# AI keys, job-source keys and notification tokens are added in the app (Settings > AI, Settings >
# Keys & services). Any of the variables listed in .env.example also work here as fallbacks.

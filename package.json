{
  "name": "job-pilot",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "node scripts/ensure-workers.mjs",
    "dev": "next dev -p 3012",
    "workers:ensure": "node scripts/ensure-workers.mjs",
    "build": "prisma generate && next build",
    "start": "next start -p 3012",
    "worker": "tsx src/worker/start.ts",
    "worker:dev": "tsx watch src/worker/start.ts",
    "worker:forever": "node scripts/workers.mjs all",
    "worker:search": "node scripts/workers.mjs search",
    "worker:apply": "node scripts/workers.mjs apply",
    "browser": "tsx scripts/apply-browser.ts",
    "portal:dry": "tsx scripts/portal-dry-run.ts",
    "record:applied": "tsx --env-file=.env scripts/record-website-application.ts",
    "lint": "eslint",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "posttest": "node scripts/check-privacy.mjs",
    "test:watch": "vitest",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:generate": "prisma generate",
    "db:studio": "prisma studio",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "prisma migrate reset --force",
    "postinstall": "prisma generate",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "seed:demo": "tsx scripts/seed-demo.ts",
    "db:dump": "node scripts/db-copy.mjs dump",
    "prod:restore": "node scripts/db-copy.mjs restore --yes",
    "prod:migrate": "node scripts/with-env.mjs .env.production.local -- npx prisma migrate deploy",
    "prod:seed": "node scripts/with-env.mjs .env.production.local -- npx tsx prisma/seed.ts",
    "prod:studio": "node scripts/with-env.mjs .env.production.local -- npx prisma studio",
    "prod:worker": "node scripts/with-env.mjs .env.production.local -- npx tsx src/worker/start.ts",
    "test:e2e:prepare": "node scripts/e2e-prepare.mjs",
    "test:e2e:reset": "node scripts/e2e-prepare.mjs --reset",
    "knowledge:export": "tsx scripts/knowledge.ts export",
    "knowledge:import": "tsx scripts/knowledge.ts import",
    "data:remove-user": "tsx scripts/remove-user.ts",
    "check:privacy": "node scripts/check-privacy.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.132.0",
    "@base-ui/react": "^1.8.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@google/genai": "^2.24.0",
    "@node-rs/argon2": "^2.2.1",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@tanstack/react-query": "^5.104.0",
    "@tanstack/react-table": "^8.21.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "cn": "^0.4.0",
    "date-fns": "^4.4.0",
    "date-fns-tz": "^3.2.0",
    "franc": "^6.2.0",
    "googleapis": "^182.0.0",
    "highlight.js": "^11.11.1",
    "imapflow": "^2.1.2",
    "lucide-react": "^1.48.0",
    "mailparser": "^3.9.31",
    "nanoid": "^6.0.1",
    "next": "16.3.6",
    "next-auth": "^5.0.0-beta.32",
    "next-themes": "^0.4.6",
    "nodemailer": "^8.0.11",
    "patchright": "^1.64.3",
    "pdf-parse": "^2.4.5",
    "pg": "^8.23.0",
    "pg-boss": "^12.35.0",
    "playwright": "^1.63.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "^10.1.0",
    "recharts": "^3.8.0",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "shadcn": "^4.21.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "vaul": "1.1.2",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/mailparser": "^3.4.6",
    "@types/node": "^24.19.0",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "prisma": "^7.10.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.2"
  }
}

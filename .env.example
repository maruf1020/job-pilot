# Job Pilot - install settings. Copy to .env and fill in the first two blocks.
# Everything about YOU (profile, keys, job sources, notifications) is entered in the app itself,
# so this file holds no personal data.

# --- Database (docker-compose reads POSTGRES_* too) ---
POSTGRES_USER=jobpilot
POSTGRES_PASSWORD=
POSTGRES_DB=job_pilot
POSTGRES_PORT=5546
DATABASE_URL=postgresql://jobpilot:PASSWORD@localhost:5546/job_pilot?schema=public

# --- App ---
APP_URL=http://localhost:3012
AUTH_URL=http://localhost:3012
# Two random secrets of 32+ characters, e.g.: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=
# Encrypts the keys and logins stored in the database. Keep it: a new value makes stored keys unreadable.
APP_ENCRYPTION_KEY=
# Server clock zone for the worker's active hours (your own time zone is set in the app).
TZ=UTC

# --- Optional: Google OAuth app for "Connect Gmail" (sending + reading replies) and "Continue with Google" ---
# Create it in Google Cloud Console; redirect URIs: ${APP_URL}/api/gmail/callback and ${APP_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Optional fallbacks ---
# AI keys and service keys are added in Settings > AI and Settings > Keys & services (or imported by
# pasting a .env file there). Values set below are only read by the "Import from .env" button or used
# as a fallback when nothing is saved in the app; they are never copied into the app on their own.
# Any <PROVIDER>_API_KEY works: GEMINI_API_KEYS (comma-separated), ANTHROPIC_API_KEY, OPENAI_API_KEY,
# DEEPSEEK_API_KEY, MOONSHOT_API_KEY, GROQ_API_KEY, OPENROUTER_API_KEY, MISTRAL_API_KEY, XAI_API_KEY ...
# Job sources: ADZUNA_APP_ID/ADZUNA_APP_KEY, JOOBLE_KEY, RAPIDAPI_KEY, REED_KEY,
#   FRANCETRAVAIL_CLIENT_ID/FRANCETRAVAIL_CLIENT_SECRET. Contact search: GOOGLE_CSE_KEY/GOOGLE_CSE_CX.
# AI-text check: SAPLING_KEY. Phone notices: NTFY_TOPIC (+NTFY_SERVER, NTFY_TOKEN) or
#   TELEGRAM_BOT_TOKEN/TELEGRAM_CHAT_ID. Mail fallback: SMTP_HOST/SMTP_PORT/SMTP_USER/SMTP_PASS/SMTP_FROM.

# --- Optional: browser apply agent (defaults come from Settings > Browser) ---
# APPLY_BROWSER_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe
# APPLY_BROWSER_PORT=9343
# APPLY_BROWSER_PROFILE_DIR=storage/chrome-profile
# APPLY_BROWSER_HEADLESS=1   (servers without a screen; extensions do not load headless)
# Your own Chrome through the Playwright extension (no "Allow remote debugging" prompts):
# PLAYWRIGHT_MCP_PROFILE_DIR_NAME=
# PLAYWRIGHT_MCP_EXTENSION_TOKEN=

# --- Optional: read-only Postgres role for the Telegram /ai questions ---
# AI_QUERY_DATABASE_URL=

# --- Worker ---
# all (default) | search | apply: two processes (npm run worker:search / worker:apply) so a crash in one never stops the other.
WORKER_ROLE=

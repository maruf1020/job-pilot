# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# prisma generated client (custom output)
/src/generated/

# local data
/storage/

# playwright
/e2e/.auth/
/test-results/
/playwright-report/

# secrets that were in the folder
New Text Document.txt
!.env.example
!.env.production.example
*.pdf
/storage/backups/

# Claude Code MCP config with machine-specific paths (apply-browser attaches to the app's Chrome)
/.mcp.json

# ops script output (mail audit results)
/scripts/ops/out/

# e2e build (npm run test:e2e:prepare)
/.next-e2e/

# knowledge pack: the optional jobs export is large and goes out of git (share it as a file)
/database/knowledge/jobs*.ndjson.gz

# local privacy denylist (npm run check:privacy) - holds personal words, never publish
/.privacy-denylist
